{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://halopsa.community/showcase/schema.json",
  "title": "HaloCommunityShowcaseItem",
  "type": "object",
  "required": [
    "id",
    "name",
    "description",
    "tags",
    "offerType",
    "license",
    "details"
  ],
  "additionalProperties": true,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+([.-][a-z0-9]+)+$",
      "description": "Lowercase dotted identifier, e.g. halocommunity.my-tool"
    },
    "name": {
      "type": "string",
      "minLength": 2,
      "maxLength": 120
    },
    "description": {
      "type": "string",
      "minLength": 10,
      "maxLength": 280
    },
    "details": {
      "type": "string",
      "minLength": 10,
      "maxLength": 10000,
      "description": "Extended details in Markdown format. Rendered through a sanitized Markdown pipeline in the UI."
    },
    "website": {
      "type": ["string", "null"],
      "format": "uri"
    },
    "source": {
      "type": ["string", "null"],
      "format": "uri"
    },
    "author": {
      "type": ["string", "null"],
      "maxLength": 120
    },
    "preview": {
      "type": ["string", "null"]
    },
    "tags": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "featured",
          "integration",
          "script",
          "reporting",
          "utility"
        ]
      }
    },
    "status": {
      "type": ["string", "null"],
      "enum": ["active", "beta", "archived", null]
    },
    "offerType": {
      "type": "string",
      "enum": ["commercial", "free", "open-source"]
    },
    "license": {
      "type": "string",
      "enum": [
        "MIT",
        "Apache-2.0",
        "AGPL-3.0",
        "GPL-3.0",
        "LGPL-3.0",
        "BSD-3-Clause",
        "MPL-2.0",
        "EPL-2.0",
        "Unlicense",
        "Proprietary",
        "Other"
      ]
    },
    "npmPackages": {
      "type": ["array", "null"],
      "items": {
        "type": "string"
      }
    },
    "minimumVersion": {
      "type": ["string", "null"]
    }
  }
}
